# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=axim_ground_game
DB_USER=postgres
DB_PASSWORD=password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Geocoding API (optional - will use mock data if not provided)
GEOCODING_API_KEY=your-geocoding-api-key

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ORIGIN_AUTH_TOKEN=replace-with-a-long-random-secret-shared-with-the-cloudflare-worker

# AXiM Core API Configuration
AXIM_CORE_API_URL=http://localhost:4000/api
AXIM_CORE_API_KEY=your-axim-core-api-key

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
AXIM_AGENTVIEW_WEBHOOK_URL="http://localhost:4000/api/agentview/webhook"

# Cloudflare R2 Audio Storage
R2_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_AUDIO_BUCKET_NAME=axim-ground-game-audio
